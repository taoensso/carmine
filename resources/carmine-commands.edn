"EVAL_RO" {:fn-name "eval_ro", :cluster-key-idx 1, :fn-params-more [script numkeys & args], :fn-params-fixed [script numkeys], :req-args-fixed ["EVAL_RO" script numkeys], :fn-docstring "`EVAL_RO` Redis command.\n\nExecutes a read-only server-side Lua script.\n\nSince Redis 7.0.0. Complexity: Depends on the script that is executed.\n\nReference: https://redis.io/commands/eval_ro/"}
"EXEC" {:fn-name "exec", :cluster-key-idx 1, :fn-params-more nil, :fn-params-fixed [], :req-args-fixed ["EXEC"], :fn-docstring "`EXEC` Redis command.\n\nExecutes all commands in a transaction.\n\nSince Redis 1.2.0. Complexity: Depends on commands in the transaction.\n\nReference: https://redis.io/commands/exec/"}
"EXISTS" {:fn-name "exists", :cluster-key-idx 1, :fn-params-more [key & args], :fn-params-fixed [key], :req-args-fixed ["EXISTS" key], :fn-docstring "`EXISTS` Redis command.\n\nDetermines whether one or more keys exist.\n\nSince Redis 1.0.0. Complexity: O(N) where N is the number of keys to check.\n\nReference: https://redis.io/commands/exists/"}
"EXPIRE" {:fn-name "expire", :cluster-key-idx 1, :fn-params-more [key seconds & args], :fn-params-fixed [key seconds], :req-args-fixed ["EXPIRE" key seconds], :fn-docstring "`EXPIRE` Redis command.\n\nSets the expiration time of a key in seconds.\n\nSince Redis 1.0.0. Complexity: O(1).\n\nReference: https://redis.io/commands/expire/"}
"EXPIREAT" {:fn-name "expireat", :cluster-key-idx 1, :fn-params-more [key unix-time-seconds & args], :fn-params-fixed [key unix-time-seconds], :req-args-fixed ["EXPIREAT" key unix-time-seconds], :fn-docstring "`EXPIREAT` Redis command.\n\nSets the expiration time of a key to a Unix timestamp.\n\nSince Redis 1.2.0. Complexity: O(1).\n\nReference: https://redis.io/commands/expireat/"}
"EXPIRETIME" {:fn-name "expiretime", :cluster-key-idx 1, :fn-params-more nil, :fn-params-fixed [key], :req-args-fixed ["EXPIRETIME" key], :fn-docstring "`EXPIRETIME` Redis command.\n\nReturns the expiration time of a key as a Unix timestamp.\n\nSince Redis 7.0.0. Complexity: O(1).\n\nReference: https://redis.io/commands/expiretime/"}
"FAILOVER" {:fn-name "failover", :cluster-key-idx 1, :fn-params-more [& args], :fn-params-fixed [], :req-args-fixed ["FAILOVER"], :fn-docstring "`FAILOVER` Redis command.\n\nStarts a coordinated failover from a server to one of its replicas.\n\nSince Redis 6.2.0. Complexity: O(1).\n\nReference: https://redis.io/commands/failover/"}
"FCALL" {:fn-name "fcall", :cluster-key-idx 1, :fn-params-more [function numkeys & args], :fn-params-fixed [function numkeys], :req-args-fixed ["FCALL" function numkeys], :fn-docstring "`FCALL` Redis command.\n\nInvokes a function.\n\nSince Redis 7.0.0. Complexity: Depends on the function that is executed.\n\nReference: https://redis.io/commands/fcall/"}
"FCALL_RO" {:fn-name "fcall_ro", :cluster-key-idx 1, :fn-params-more [function numkeys & args], :fn-params-fixed [function numkeys], :req-args-fixed ["FCALL_RO" function numkeys], :fn-docstring "`FCALL_RO` Redis command.\n\nInvokes a read-only function.\n\nSince Redis 7.0.0. Complexity: Depends on the function that is executed.\n\nReference: https://redis.io/commands/fcall_ro/"}
"FLUSHALL" {:fn-name "flushall", :cluster-key-idx 1, :fn-params-more [& args], :fn-params-fixed [], :req-args-fixed ["FLUSHALL"], :fn-docstring "`FLUSHALL` Redis command.\n\nRemoves all keys from all databases.\n\nSince Redis 1.0.0. Complexity: O(N) where N is the total number of keys in all databases.\n\nReference: https://redis.io/commands/flushall/"}
"FLUSHDB" {:fn-name "flushdb", :cluster-key-idx 1, :fn-params-more [& args], :fn-params-fixed [], :req-args-fixed ["FLUSHDB"], :fn-docstring "`FLUSHDB` Redis command.\n\nRemove all keys from the current database.\n\nSince Redis 1.0.0. Complexity: O(N) where N is the number of keys in the selected database.\n\nReference: https://redis.io/commands/flushdb/"}
"FUNCTION" {:fn-name "function", :cluster-key-idx 1, :fn-params-more [arg1 & args], :fn-params-fixed [arg1], :req-args-fixed ["FUNCTION" arg1], :fn-docstring "`FUNCTION` Redis command.\n\nA container for function commands.\n\nSince Redis 7.0.0. Complexity: Depends on subcommand.\n\nReference: https://redis.io/commands/function/"}
"FUNCTION DELETE" {:fn-name "function-delete", :cluster-key-idx 2, :fn-params-more nil, :fn-params-fixed [library-name], :req-args-fixed ["FUNCTION" "DELETE" library-name], :fn-docstring "`FUNCTION DELETE` Redis command.\n\nDeletes a library and its functions.\n\nSince Redis 7.0.0. Complexity: O(1).\n\nReference: https://redis.io/commands/function-delete/"}
"FUNCTION DUMP" {:fn-name "function-dump", :cluster-key-idx 2, :fn-params-more nil, :fn-params-fixed [], :req-args-fixed ["FUNCTION" "DUMP"], :fn-docstring "`FUNCTION DUMP` Redis command.\n\nDumps all libraries into a serialized binary payload.\n\nSince Redis 7.0.0. Complexity: O(N) where N is the number of functions.\n\nReference: https://redis.io/commands/function-dump/"}
"FUNCTION FLUSH" {:fn-name "function-flush", :cluster-key-idx 2, :fn-params-more [& args], :fn-params-fixed [], :req-args-fixed ["FUNCTION" "FLUSH"], :fn-docstring "`FUNCTION FLUSH` Redis command.\n\nDeletes all libraries and functions.\n\nSince Redis 7.0.0. Complexity: O(N) where N is the number of functions deleted.\n\nReference: https://redis.io/commands/function-flush/"}
"FUNCTION HELP" {:fn-name "function-help", :cluster-key-idx 2, :fn-params-more nil, :fn-params-fixed [], :req-args-fixed ["FUNCTION" "HELP"], :fn-docstring "`FUNCTION HELP` Redis command.\n\nReturns helpful text about the different subcommands.\n\nSince Redis 7.0.0. Complexity: O(1).\n\nReference: https://redis.io/commands/function-help/"}
"FUNCTION KILL" {:fn-name "function-kill", :cluster-key-idx 2, :fn-params-more nil, :fn-params-fixed [], :req-args-fixed ["FUNCTION" "KILL"], :fn-docstring "`FUNCTION KILL` Redis command.\n\nTerminates a function during execution.\n\nSince Redis 7.0.0. Complexity: O(1).\n\nReference: https://redis.io/commands/function-kill/"}
"FUNCTION LIST" {:fn-name "function-list", :cluster-key-idx 2, :fn-params-more [& args], :fn-params-fixed [], :req-args-fixed ["FUNCTION" "LIST"], :fn-docstring "`FUNCTION LIST` Redis command.\n\nReturns information about all libraries.\n\nSince Redis 7.0.0. Complexity: O(N) where N is the number of functions.\n\nReference: https://redis.io/commands/function-list/"}
"FUNCTION LOAD" {:fn-name "function-load", :cluster-key-idx 2, :fn-params-more [arg1 & args], :fn-params-fixed [arg1], :req-args-fixed ["FUNCTION" "LOAD" arg1], :fn-docstring "`FUNCTION LOAD` Redis command.\n\nCreates a library.\n\nSince Redis 7.0.0. Complexity: O(1) (considering compilation time is redundant).\n\nReference: https://redis.io/commands/function-load/"}
"FUNCTION RESTORE" {:fn-name "function-restore", :cluster-key-idx 2, :fn-params-more [serialized-value & args], :fn-params-fixed [serialized-value], :req-args-fixed ["FUNCTION" "RESTORE" serialized-value], :fn-docstring "`FUNCTION RESTORE` Redis command.\n\nRestores all libraries from a payload.\n\nSince Redis 7.0.0. Complexity: O(N) where N is the number of functions on the payload.\n\nReference: https://redis.io/commands/function-restore/"}
"FUNCTION STATS" {:fn-name "function-stats", :cluster-key-idx 2, :fn-params-more nil, :fn-params-fixed [], :req-args-fixed ["FUNCTION" "STATS"], :fn-docstring "`FUNCTION STATS` Redis command.\n\nReturns information about a function during execution.\n\nSince Redis 7.0.0. Complexity: O(1).\n\nReference: https://redis.io/commands/function-stats/"}
"GEOADD" {:fn-name "geoadd", :cluster-key-idx 1, :fn-params-more [key arg1 arg2 arg3 & args], :fn-params-fixed [key arg1 arg2 arg3], :req-args-fixed ["GEOADD" key arg1 arg2 arg3], :fn-docstring "`GEOADD` Redis command.\n\nAdds one or more members to a geospatial index. The key is created if it doesn't exist.\n\nSince Redis 3.2.0. Complexity: O(log(N)) for each item added, where N is the number of elements in the sorted set.\n\nReference: https://redis.io/commands/geoadd/"}
"GEODIST" {:fn-name "geodist", :cluster-key-idx 1, :fn-params-more [key member1 member2 & args], :fn-params-fixed [key member1 member2], :req-args-fixed ["GEODIST" key member1 member2], :fn-docstring "`GEODIST` Redis command.\n\nReturns the distance between two members of a geospatial index.\n\nSince Redis 3.2.0. Complexity: O(1).\n\nReference: https://redis.io/commands/geodist/"}
"GEOHASH" {:fn-name "geohash", :cluster-key-idx 1, :fn-params-more [key & args], :fn-params-fixed [key], :req-args-fixed ["GEOHASH" key], :fn-docstring "`GEOHASH` Redis command.\n\nReturns members from a geospatial index as geohash strings.\n\nSince Redis 3.2.0. Complexity: O(1) for each member requested.\n\nReference: https://redis.io/commands/geohash/"}
"GEOPOS" {:fn-name "geopos", :cluster-key-idx 1, :fn-params-more [key & args], :fn-params-fixed [key], :req-args-fixed ["GEOPOS" key], :fn-docstring "`GEOPOS` Redis command.\n\nReturns the longitude and latitude of members from a geospatial index.\n\nSince Redis 3.2.0. Complexity: O(1) for each member requested.\n\nReference: https://redis.io/commands/geopos/"}
"GEORADIUS" {:fn-name "georadius", :cluster-key-idx 1, :fn-params-more [key longitude latitude radius arg1 & args], :fn-params-fixed [key longitude latitude radius arg1], :req-args-fixed ["GEORADIUS" key longitude latitude radius arg1], :fn-docstring "`GEORADIUS` Redis command.\n\nQueries a geospatial index for members within a distance from a coordinate, optionally stores the result.\n\nSince Redis 3.2.0. Complexity: O(N+log(M)) where N is the number of elements inside the bounding box of the circular area delimited by center and radius and M is the number of items inside the index.\n\nReference: https://redis.io/commands/georadius/"}
"GEORADIUSBYMEMBER" {:fn-name "georadiusbymember", :cluster-key-idx 1, :fn-params-more [key member radius arg1 & args], :fn-params-fixed [key member radius arg1], :req-args-fixed ["GEORADIUSBYMEMBER" key member radius arg1], :fn-docstring "`GEORADIUSBYMEMBER` Redis command.\n\nQueries a geospatial index for members within a distance from a member, optionally stores the result.\n\nSince Redis 3.2.0. Complexity: O(N+log(M)) where N is the number of elements inside the bounding box of the circular area delimited by center and radius and M is the number of items inside the index.\n\nReference: https://redis.io/commands/georadiusbymember/"}
"GEORADIUSBYMEMBER_RO" {:fn-name "georadiusbymember_ro", :cluster-key-idx 1, :fn-params-more [key member radius arg1 & args], :fn-params-fixed [key member radius arg1], :req-args-fixed ["GEORADIUSBYMEMBER_RO" key member radius arg1], :fn-docstring "`GEORADIUSBYMEMBER_RO` Redis command.\n\nReturns members from a geospatial index that are within a distance from a member.\n\nSince Redis 3.2.10. Complexity: O(N+log(M)) where N is the number of elements inside the bounding box of the circular area delimited by center and radius and M is the number of items inside the index.\n\nReference: https://redis.io/commands/georadiusbymember_ro/"}
"GEORADIUS_RO" {:fn-name "georadius_ro", :cluster-key-idx 1, :fn-params-more [key longitude latitude radius arg1 & args], :fn-params-fixed [key longitude latitude radius arg1], :req-args-fixed ["GEORADIUS_RO" key longitude latitude radius arg1], :fn-docstring "`GEORADIUS_RO` Redis command.\n\nReturns members from a geospatial index that are within a distance from a coordinate.\n\nSince Redis 3.2.10. Complexity: O(N+log(M)) where N is the number of elements inside the bounding box of the circular area delimited by center and radius and M is the number of items inside the index.\n\nReference: https://redis.io/commands/georadius_ro/"}
"GEOSEARCH" {:fn-name "geosearch", :cluster-key-idx 1, :fn-params-more [key arg1 arg2 arg3 arg4 arg5 & args], :fn-params-fixed [key arg1 arg2 arg3 arg4 arg5], :req-args-fixed ["GEOSEARCH" key arg1 arg2 arg3 arg4 arg5], :fn-docstring "`GEOSEARCH` Redis command.\n\nQueries a geospatial index for members inside an area of a box or a circle.\n\nSince Redis 6.2.0. Complexity: O(N+log(M)) where N is the number of elements in the grid-aligned bounding box area around the shape provided as the filter and M is the number of items inside the shape.\n\nReference: https://redis.io/commands/geosearch/"}
"GEOSEARCHSTORE" {:fn-name "geosearchstore", :cluster-key-idx 1, :fn-params-more [destination source arg1 arg2 arg3 arg4 arg5 & args], :fn-params-fixed [destination source arg1 arg2 arg3 arg4 arg5], :req-args-fixed ["GEOSEARCHSTORE" destination source arg1 arg2 arg3 arg4 arg5], :fn-docstring "`GEOSEARCHSTORE` Redis command.\n\nQueries a geospatial index for members inside an area of a box or a circle, optionally stores the result.\n\nSince Redis 6.2.0. Complexity: O(N+log(M)) where N is the number of elements in the grid-aligned bounding box area around the shape provided as the filter and M is the number of items inside the shape.\n\nReference: https://redis.io/commands/geosearchstore/"}
"GET" {:fn-name "get", :cluster-key-idx 1, :fn-params-more nil, :fn-params-fixed [key], :req-args-fixed ["GET" key], :fn-docstring "`GET` Redis command.\n\nReturns the string value of a key.\n\nSince Redis 1.0.0. Complexity: O(1).\n\nReference: https://redis.io/commands/get/"}
"GETBIT" {:fn-name "getbit", :cluster-key-idx 1, :fn-params-more nil, :fn-params-fixed [key offset], :req-args-fixed ["GETBIT" key offset], :fn-docstring "`GETBIT` Redis command.\n\nReturns a bit value by offset.\n\nSince Redis 2.2.0. Complexity: O(1).\n\nReference: https://redis.io/commands/getbit/"}
"GETDEL" {:fn-name "getdel", :cluster-key-idx 1, :fn-params-more nil, :fn-params-fixed [key], :req-args-fixed ["GETDEL" key], :fn-docstring "`GETDEL` Redis command.\n\nReturns the string value of a key after deleting the key.\n\nSince Redis 6.2.0. Complexity: O(1).\n\nReference: https://redis.io/commands/getdel/"}
"GETEX" {:fn-name "getex", :cluster-key-idx 1, :fn-params-more [key & args], :fn-params-fixed [key], :req-args-fixed ["GETEX" key], :fn-docstring "`GETEX` Redis command.\n\nReturns the string value of a key after setting its expiration time.\n\nSince Redis 6.2.0. Complexity: O(1).\n\nReference: https://redis.io/commands/getex/"}
"GETRANGE" {:fn-name "getrange", :cluster-key-idx 1, :fn-params-more nil, :fn-params-fixed [key start end], :req-args-fixed ["GETRANGE" key start end], :fn-docstring "`GETRANGE` Redis command.\n\nReturns a substring of the string stored at a key.\n\nSince Redis 2.4.0. Complexity: O(N) where N is the length of the returned string. The complexity is ultimately determined by the returned length, but because creating a substring from an existing string is very cheap, it can be considered O(1) for small strings.\n\nReference: https://redis.io/commands/getrange/"}
