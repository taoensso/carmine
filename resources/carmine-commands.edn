{
"ACL" {:fn-name "acl", :cluster-key-idx 1, :fn-params-more [arg1 & args], :fn-params-fixed [arg1], :req-args-fixed ["ACL" arg1], :fn-docstring "`ACL` Redis command.\n\nA container for Access List Control commands.\n\nSince Redis 6.0.0. Complexity: Depends on subcommand.\n\nReference: https://redis.io/commands/acl/"}
"ACL CAT" {:fn-name "acl-cat", :cluster-key-idx 2, :fn-params-more [& args], :fn-params-fixed [], :req-args-fixed ["ACL" "CAT"], :fn-docstring "`ACL CAT` Redis command.\n\nLists the ACL categories, or the commands inside a category.\n\nSince Redis 6.0.0. Complexity: O(1) since the categories and commands are a fixed set.\n\nReference: https://redis.io/commands/acl-cat/"}
"ACL DELUSER" {:fn-name "acl-deluser", :cluster-key-idx 2, :fn-params-more [username & args], :fn-params-fixed [username], :req-args-fixed ["ACL" "DELUSER" username], :fn-docstring "`ACL DELUSER` Redis command.\n\nDeletes ACL users, and terminates their connections.\n\nSince Redis 6.0.0. Complexity: O(1) amortized time considering the typical user.\n\nReference: https://redis.io/commands/acl-deluser/"}
"ACL DRYRUN" {:fn-name "acl-dryrun", :cluster-key-idx 2, :fn-params-more [username command & args], :fn-params-fixed [username command], :req-args-fixed ["ACL" "DRYRUN" username command], :fn-docstring "`ACL DRYRUN` Redis command.\n\nSimulates the execution of a command by a user, without executing the command.\n\nSince Redis 7.0.0. Complexity: O(1).\n\nReference: https://redis.io/commands/acl-dryrun/"}
"ACL GENPASS" {:fn-name "acl-genpass", :cluster-key-idx 2, :fn-params-more [& args], :fn-params-fixed [], :req-args-fixed ["ACL" "GENPASS"], :fn-docstring "`ACL GENPASS` Redis command.\n\nGenerates a pseudorandom, secure password that can be used to identify ACL users.\n\nSince Redis 6.0.0. Complexity: O(1).\n\nReference: https://redis.io/commands/acl-genpass/"}
"ACL GETUSER" {:fn-name "acl-getuser", :cluster-key-idx 2, :fn-params-more nil, :fn-params-fixed [username], :req-args-fixed ["ACL" "GETUSER" username], :fn-docstring "`ACL GETUSER` Redis command.\n\nLists the ACL rules of a user.\n\nSince Redis 6.0.0. Complexity: O(N). Where N is the number of password, command and pattern rules that the user has.\n\nReference: https://redis.io/commands/acl-getuser/"}
"ACL HELP" {:fn-name "acl-help", :cluster-key-idx 2, :fn-params-more nil, :fn-params-fixed [], :req-args-fixed ["ACL" "HELP"], :fn-docstring "`ACL HELP` Redis command.\n\nReturns helpful text about the different subcommands.\n\nSince Redis 6.0.0. Complexity: O(1).\n\nReference: https://redis.io/commands/acl-help/"}
"ACL LIST" {:fn-name "acl-list", :cluster-key-idx 2, :fn-params-more nil, :fn-params-fixed [], :req-args-fixed ["ACL" "LIST"], :fn-docstring "`ACL LIST` Redis command.\n\nDumps the effective rules in ACL file format.\n\nSince Redis 6.0.0. Complexity: O(N). Where N is the number of configured users.\n\nReference: https://redis.io/commands/acl-list/"}
"ACL LOAD" {:fn-name "acl-load", :cluster-key-idx 2, :fn-params-more nil, :fn-params-fixed [], :req-args-fixed ["ACL" "LOAD"], :fn-docstring "`ACL LOAD` Redis command.\n\nReloads the rules from the configured ACL file.\n\nSince Redis 6.0.0. Complexity: O(N). Where N is the number of configured users.\n\nReference: https://redis.io/commands/acl-load/"}
"ACL LOG" {:fn-name "acl-log", :cluster-key-idx 2, :fn-params-more [& args], :fn-params-fixed [], :req-args-fixed ["ACL" "LOG"], :fn-docstring "`ACL LOG` Redis command.\n\nLists recent security events generated due to ACL rules.\n\nSince Redis 6.0.0. Complexity: O(N) with N being the number of entries shown.\n\nReference: https://redis.io/commands/acl-log/"}
"ACL SAVE" {:fn-name "acl-save", :cluster-key-idx 2, :fn-params-more nil, :fn-params-fixed [], :req-args-fixed ["ACL" "SAVE"], :fn-docstring "`ACL SAVE` Redis command.\n\nSaves the effective ACL rules in the configured ACL file.\n\nSince Redis 6.0.0. Complexity: O(N). Where N is the number of configured users.\n\nReference: https://redis.io/commands/acl-save/"}
"ACL SETUSER" {:fn-name "acl-setuser", :cluster-key-idx 2, :fn-params-more [username & args], :fn-params-fixed [username], :req-args-fixed ["ACL" "SETUSER" username], :fn-docstring "`ACL SETUSER` Redis command.\n\nCreates and modifies an ACL user and its rules.\n\nSince Redis 6.0.0. Complexity: O(N). Where N is the number of rules provided.\n\nReference: https://redis.io/commands/acl-setuser/"}
"ACL USERS" {:fn-name "acl-users", :cluster-key-idx 2, :fn-params-more nil, :fn-params-fixed [], :req-args-fixed ["ACL" "USERS"], :fn-docstring "`ACL USERS` Redis command.\n\nLists all ACL users.\n\nSince Redis 6.0.0. Complexity: O(N). Where N is the number of configured users.\n\nReference: https://redis.io/commands/acl-users/"}
"ACL WHOAMI" {:fn-name "acl-whoami", :cluster-key-idx 2, :fn-params-more nil, :fn-params-fixed [], :req-args-fixed ["ACL" "WHOAMI"], :fn-docstring "`ACL WHOAMI` Redis command.\n\nReturns the authenticated username of the current connection.\n\nSince Redis 6.0.0. Complexity: O(1).\n\nReference: https://redis.io/commands/acl-whoami/"}
"APPEND" {:fn-name "append", :cluster-key-idx 1, :fn-params-more nil, :fn-params-fixed [key value], :req-args-fixed ["APPEND" key value], :fn-docstring "`APPEND` Redis command.\n\nAppends a string to the value of a key. Creates the key if it doesn't exist.\n\nSince Redis 2.0.0. Complexity: O(1). The amortized time complexity is O(1) assuming the appended value is small and the already present value is of any size, since the dynamic string library used by Redis will double the free space available on every reallocation.\n\nReference: https://redis.io/commands/append/"}
"ARCOUNT" {:fn-name "arcount", :cluster-key-idx 1, :fn-params-more nil, :fn-params-fixed [key], :req-args-fixed ["ARCOUNT" key], :fn-docstring "`ARCOUNT` Redis command.\n\nReturns the number of non-empty elements in an array.\n\nSince Redis 8.8.0. Complexity: O(1).\n\nReference: https://redis.io/commands/arcount/"}
"ARDEL" {:fn-name "ardel", :cluster-key-idx 1, :fn-params-more [key index & args], :fn-params-fixed [key index], :req-args-fixed ["ARDEL" key index], :fn-docstring "`ARDEL` Redis command.\n\nDeletes elements at the specified indices in an array.\n\nSince Redis 8.8.0. Complexity: O(N) where N is the number of indices to delete.\n\nReference: https://redis.io/commands/ardel/"}
"ARDELRANGE" {:fn-name "ardelrange", :cluster-key-idx 1, :fn-params-more [key arg1 arg2 & args], :fn-params-fixed [key arg1 arg2], :req-args-fixed ["ARDELRANGE" key arg1 arg2], :fn-docstring "`ARDELRANGE` Redis command.\n\nDeletes elements in one or more ranges.\n\nSince Redis 8.8.0. Complexity: Proportional to the number of existing elements / slices touched, not to the numeric span of the requested ranges.\n\nReference: https://redis.io/commands/ardelrange/"}
"ARGET" {:fn-name "arget", :cluster-key-idx 1, :fn-params-more nil, :fn-params-fixed [key index], :req-args-fixed ["ARGET" key index], :fn-docstring "`ARGET` Redis command.\n\nGets the value at an index in an array.\n\nSince Redis 8.8.0. Complexity: O(1).\n\nReference: https://redis.io/commands/arget/"}
"ARGETRANGE" {:fn-name "argetrange", :cluster-key-idx 1, :fn-params-more nil, :fn-params-fixed [key start end], :req-args-fixed ["ARGETRANGE" key start end], :fn-docstring "`ARGETRANGE` Redis command.\n\nGets values in a range of indices.\n\nSince Redis 8.8.0. Complexity: O(N) where N is the range length.\n\nReference: https://redis.io/commands/argetrange/"}
"ARGREP" {:fn-name "argrep", :cluster-key-idx 1, :fn-params-more [key start end arg1 arg2 & args], :fn-params-fixed [key start end arg1 arg2], :req-args-fixed ["ARGREP" key start end arg1 arg2], :fn-docstring "`ARGREP` Redis command.\n\nSearches array elements in a range using textual predicates.\n\nSince Redis 8.8.0. Complexity: O(P * C) where P is the number of visited positions in touched slices and C is the cost of evaluating the predicates on one existing element.\n\nReference: https://redis.io/commands/argrep/"}
"ARINFO" {:fn-name "arinfo", :cluster-key-idx 1, :fn-params-more [key & args], :fn-params-fixed [key], :req-args-fixed ["ARINFO" key], :fn-docstring "`ARINFO` Redis command.\n\nReturns metadata about an array.\n\nSince Redis 8.8.0. Complexity: O(1), or O(N) with FULL option where N is the number of slices.\n\nReference: https://redis.io/commands/arinfo/"}
"ARINSERT" {:fn-name "arinsert", :cluster-key-idx 1, :fn-params-more [key value & args], :fn-params-fixed [key value], :req-args-fixed ["ARINSERT" key value], :fn-docstring "`ARINSERT` Redis command.\n\nInserts one or more values at consecutive indices.\n\nSince Redis 8.8.0. Complexity: O(N) where N is the number of values.\n\nReference: https://redis.io/commands/arinsert/"}
"ARLASTITEMS" {:fn-name "arlastitems", :cluster-key-idx 1, :fn-params-more [key count & args], :fn-params-fixed [key count], :req-args-fixed ["ARLASTITEMS" key count], :fn-docstring "`ARLASTITEMS` Redis command.\n\nReturns the most recently inserted elements.\n\nSince Redis 8.8.0. Complexity: O(N) where N is the count.\n\nReference: https://redis.io/commands/arlastitems/"}
"ARLEN" {:fn-name "arlen", :cluster-key-idx 1, :fn-params-more nil, :fn-params-fixed [key], :req-args-fixed ["ARLEN" key], :fn-docstring "`ARLEN` Redis command.\n\nReturns the length of an array (max index + 1).\n\nSince Redis 8.8.0. Complexity: O(1).\n\nReference: https://redis.io/commands/arlen/"}
"ARMGET" {:fn-name "armget", :cluster-key-idx 1, :fn-params-more [key index & args], :fn-params-fixed [key index], :req-args-fixed ["ARMGET" key index], :fn-docstring "`ARMGET` Redis command.\n\nGets values at multiple indices in an array.\n\nSince Redis 8.8.0. Complexity: O(N) where N is the number of indices.\n\nReference: https://redis.io/commands/armget/"}
"ARMSET" {:fn-name "armset", :cluster-key-idx 1, :fn-params-more [key arg1 arg2 & args], :fn-params-fixed [key arg1 arg2], :req-args-fixed ["ARMSET" key arg1 arg2], :fn-docstring "`ARMSET` Redis command.\n\nSets multiple index-value pairs in an array.\n\nSince Redis 8.8.0. Complexity: O(N) where N is the number of pairs.\n\nReference: https://redis.io/commands/armset/"}
"ARNEXT" {:fn-name "arnext", :cluster-key-idx 1, :fn-params-more nil, :fn-params-fixed [key], :req-args-fixed ["ARNEXT" key], :fn-docstring "`ARNEXT` Redis command.\n\nReturns the next index ARINSERT would use.\n\nSince Redis 8.8.0. Complexity: O(1).\n\nReference: https://redis.io/commands/arnext/"}
"AROP" {:fn-name "arop", :cluster-key-idx 1, :fn-params-more [key start end arg1 & args], :fn-params-fixed [key start end arg1], :req-args-fixed ["AROP" key start end arg1], :fn-docstring "`AROP` Redis command.\n\nPerforms aggregate operations on array elements in a range.\n\nSince Redis 8.8.0. Complexity: O(P) where P is visited positions in touched slices (dense scanned slots + sparse entries), with worst-case O(|end-start|+1) and typical case close to O(N), where N is the number of existing elements in range.\n\nReference: https://redis.io/commands/arop/"}
"ARRING" {:fn-name "arring", :cluster-key-idx 1, :fn-params-more [key size value & args], :fn-params-fixed [key size value], :req-args-fixed ["ARRING" key size value], :fn-docstring "`ARRING` Redis command.\n\nInserts values into a ring buffer of specified size, wrapping and truncating as needed.\n\nSince Redis 8.8.0. Complexity: O(M) normally, O(N+M) on ring resize, where N is the maximum of the old and new ring size and M is the number of inserted values.\n\nReference: https://redis.io/commands/arring/"}
"ARSCAN" {:fn-name "arscan", :cluster-key-idx 1, :fn-params-more [key start end & args], :fn-params-fixed [key start end], :req-args-fixed ["ARSCAN" key start end], :fn-docstring "`ARSCAN` Redis command.\n\nIterates existing elements in a range, returning index-value pairs.\n\nSince Redis 8.8.0. Complexity: O(P) where P is visited positions in touched slices (dense scanned slots + sparse entries), with worst-case O(|end-start|+1) and typical case close to O(N), where N is the number of existing elements in range.\n\nReference: https://redis.io/commands/arscan/"}
"ARSEEK" {:fn-name "arseek", :cluster-key-idx 1, :fn-params-more nil, :fn-params-fixed [key index], :req-args-fixed ["ARSEEK" key index], :fn-docstring "`ARSEEK` Redis command.\n\nSets the ARINSERT / ARRING cursor to a specific index.\n\nSince Redis 8.8.0. Complexity: O(1).\n\nReference: https://redis.io/commands/arseek/"}
"ARSET" {:fn-name "arset", :cluster-key-idx 1, :fn-params-more [key index value & args], :fn-params-fixed [key index value], :req-args-fixed ["ARSET" key index value], :fn-docstring "`ARSET` Redis command.\n\nSets one or more contiguous values starting at an index in an array.\n\nSince Redis 8.8.0. Complexity: O(N) where N is the number of values.\n\nReference: https://redis.io/commands/arset/"}
"ASKING" {:fn-name "asking", :cluster-key-idx 1, :fn-params-more nil, :fn-params-fixed [], :req-args-fixed ["ASKING"], :fn-docstring "`ASKING` Redis command.\n\nSignals that a cluster client is following an -ASK redirect.\n\nSince Redis 3.0.0. Complexity: O(1).\n\nReference: https://redis.io/commands/asking/"}
"AUTH" {:fn-name "auth", :cluster-key-idx 1, :fn-params-more [arg1 & args], :fn-params-fixed [arg1], :req-args-fixed ["AUTH" arg1], :fn-docstring "`AUTH` Redis command.\n\nAuthenticates the connection.\n\nSince Redis 1.0.0. Complexity: O(N) where N is the number of passwords defined for the user.\n\nReference: https://redis.io/commands/auth/"}
"BGREWRITEAOF" {:fn-name "bgrewriteaof", :cluster-key-idx 1, :fn-params-more nil, :fn-params-fixed [], :req-args-fixed ["BGREWRITEAOF"], :fn-docstring "`BGREWRITEAOF` Redis command.\n\nAsynchronously rewrites the append-only file to disk.\n\nSince Redis 1.0.0. Complexity: O(1).\n\nReference: https://redis.io/commands/bgrewriteaof/"}
"BGSAVE" {:fn-name "bgsave", :cluster-key-idx 1, :fn-params-more [& args], :fn-params-fixed [], :req-args-fixed ["BGSAVE"], :fn-docstring "`BGSAVE` Redis command.\n\nAsynchronously saves the database(s) to disk.\n\nSince Redis 1.0.0. Complexity: O(1).\n\nReference: https://redis.io/commands/bgsave/"}
"BITCOUNT" {:fn-name "bitcount", :cluster-key-idx 1, :fn-params-more [key & args], :fn-params-fixed [key], :req-args-fixed ["BITCOUNT" key], :fn-docstring "`BITCOUNT` Redis command.\n\nCounts the number of set bits (population counting) in a string.\n\nSince Redis 2.6.0. Complexity: O(N).\n\nReference: https://redis.io/commands/bitcount/"}
"BITFIELD" {:fn-name "bitfield", :cluster-key-idx 1, :fn-params-more [key & args], :fn-params-fixed [key], :req-args-fixed ["BITFIELD" key], :fn-docstring "`BITFIELD` Redis command.\n\nPerforms arbitrary bitfield integer operations on strings.\n\nSince Redis 3.2.0. Complexity: O(1) for each subcommand specified.\n\nReference: https://redis.io/commands/bitfield/"}
"BITFIELD_RO" {:fn-name "bitfield_ro", :cluster-key-idx 1, :fn-params-more [key & args], :fn-params-fixed [key], :req-args-fixed ["BITFIELD_RO" key], :fn-docstring "`BITFIELD_RO` Redis command.\n\nPerforms arbitrary read-only bitfield integer operations on strings.\n\nSince Redis 6.0.0. Complexity: O(1) for each subcommand specified.\n\nReference: https://redis.io/commands/bitfield_ro/"}
"BITOP" {:fn-name "bitop", :cluster-key-idx 1, :fn-params-more [arg1 arg2 arg3 & args], :fn-params-fixed [arg1 arg2 arg3], :req-args-fixed ["BITOP" arg1 arg2 arg3], :fn-docstring "`BITOP` Redis command.\n\nPerforms bitwise operations on multiple strings, and stores the result.\n\nSince Redis 2.6.0. Complexity: O(N).\n\nReference: https://redis.io/commands/bitop/"}
"BITPOS" {:fn-name "bitpos", :cluster-key-idx 1, :fn-params-more [key bit & args], :fn-params-fixed [key bit], :req-args-fixed ["BITPOS" key bit], :fn-docstring "`BITPOS` Redis command.\n\nFinds the first set (1) or clear (0) bit in a string.\n\nSince Redis 2.8.7. Complexity: O(N).\n\nReference: https://redis.io/commands/bitpos/"}
"BLMOVE" {:fn-name "blmove", :cluster-key-idx 1, :fn-params-more nil, :fn-params-fixed [source destination arg1 arg2 arg3], :req-args-fixed ["BLMOVE" source destination arg1 arg2 arg3], :fn-docstring "`BLMOVE` Redis command.\n\nPops an element from a list, pushes it to another list and returns it. Blocks until an element is available otherwise. Deletes the list if the last element was moved.\n\nSince Redis 6.2.0. Complexity: O(1).\n\nReference: https://redis.io/commands/blmove/"}
"BLMPOP" {:fn-name "blmpop", :cluster-key-idx 1, :fn-params-more [timeout numkeys key arg1 & args], :fn-params-fixed [timeout numkeys key arg1], :req-args-fixed ["BLMPOP" timeout numkeys key arg1], :fn-docstring "`BLMPOP` Redis command.\n\nPops the first element from one of multiple lists. Blocks until an element is available otherwise. Deletes the list if the last element was popped.\n\nSince Redis 7.0.0. Complexity: O(N+M) where N is the number of provided keys and M is the number of elements returned.\n\nReference: https://redis.io/commands/blmpop/"}
"BLPOP" {:fn-name "blpop", :cluster-key-idx 1, :fn-params-more [key arg1 & args], :fn-params-fixed [key arg1], :req-args-fixed ["BLPOP" key arg1], :fn-docstring "`BLPOP` Redis command.\n\nRemoves and returns the first element in a list. Blocks until an element is available otherwise. Deletes the list if the last element was popped.\n\nSince Redis 2.0.0. Complexity: O(N) where N is the number of provided keys.\n\nReference: https://redis.io/commands/blpop/"}
"BRPOP" {:fn-name "brpop", :cluster-key-idx 1, :fn-params-more [key arg1 & args], :fn-params-fixed [key arg1], :req-args-fixed ["BRPOP" key arg1], :fn-docstring "`BRPOP` Redis command.\n\nRemoves and returns the last element in a list. Blocks until an element is available otherwise. Deletes the list if the last element was popped.\n\nSince Redis 2.0.0. Complexity: O(N) where N is the number of provided keys.\n\nReference: https://redis.io/commands/brpop/"}
"BRPOPLPUSH" {:fn-name "brpoplpush", :cluster-key-idx 1, :fn-params-more nil, :fn-params-fixed [source destination timeout], :req-args-fixed ["BRPOPLPUSH" source destination timeout], :fn-docstring "`BRPOPLPUSH` Redis command.\n\nPops an element from a list, pushes it to another list and returns it. Block until an element is available otherwise. Deletes the list if the last element was popped.\n\nSince Redis 2.2.0. Complexity: O(1).\n\nReference: https://redis.io/commands/brpoplpush/"}
"BZMPOP" {:fn-name "bzmpop", :cluster-key-idx 1, :fn-params-more [timeout numkeys key arg1 & args], :fn-params-fixed [timeout numkeys key arg1], :req-args-fixed ["BZMPOP" timeout numkeys key arg1], :fn-docstring "`BZMPOP` Redis command.\n\nRemoves and returns a member by score from one or more sorted sets. Blocks until a member is available otherwise. Deletes the sorted set if the last element was popped.\n\nSince Redis 7.0.0. Complexity: O(K) + O(M*log(N)) where K is the number of provided keys, N being the number of elements in the sorted set, and M being the number of elements popped.\n\nReference: https://redis.io/commands/bzmpop/"}
"BZPOPMAX" {:fn-name "bzpopmax", :cluster-key-idx 1, :fn-params-more [key arg1 & args], :fn-params-fixed [key arg1], :req-args-fixed ["BZPOPMAX" key arg1], :fn-docstring "`BZPOPMAX` Redis command.\n\nRemoves and returns the member with the highest score from one or more sorted sets. Blocks until a member available otherwise.  Deletes the sorted set if the last element was popped.\n\nSince Redis 5.0.0. Complexity: O(log(N)) with N being the number of elements in the sorted set.\n\nReference: https://redis.io/commands/bzpopmax/"}
"BZPOPMIN" {:fn-name "bzpopmin", :cluster-key-idx 1, :fn-params-more [key arg1 & args], :fn-params-fixed [key arg1], :req-args-fixed ["BZPOPMIN" key arg1], :fn-docstring "`BZPOPMIN` Redis command.\n\nRemoves and returns the member with the lowest score from one or more sorted sets. Blocks until a member is available otherwise. Deletes the sorted set if the last element was popped.\n\nSince Redis 5.0.0. Complexity: O(log(N)) with N being the number of elements in the sorted set.\n\nReference: https://redis.io/commands/bzpopmin/"}
"CLIENT" {:fn-name "client", :cluster-key-idx 1, :fn-params-more [arg1 & args], :fn-params-fixed [arg1], :req-args-fixed ["CLIENT" arg1], :fn-docstring "`CLIENT` Redis command.\n\nA container for client connection commands.\n\nSince Redis 2.4.0. Complexity: Depends on subcommand.\n\nReference: https://redis.io/commands/client/"}
"CLIENT CACHING" {:fn-name "client-caching", :cluster-key-idx 2, :fn-params-more nil, :fn-params-fixed [arg1], :req-args-fixed ["CLIENT" "CACHING" arg1], :fn-docstring "`CLIENT CACHING` Redis command.\n\nInstructs the server whether to track the keys in the next request.\n\nSince Redis 6.0.0. Complexity: O(1).\n\nReference: https://redis.io/commands/client-caching/"}
"CLIENT GETNAME" {:fn-name "client-getname", :cluster-key-idx 2, :fn-params-more nil, :fn-params-fixed [], :req-args-fixed ["CLIENT" "GETNAME"], :fn-docstring "`CLIENT GETNAME` Redis command.\n\nReturns the name of the connection.\n\nSince Redis 2.6.9. Complexity: O(1).\n\nReference: https://redis.io/commands/client-getname/"}
"CLIENT GETREDIR" {:fn-name "client-getredir", :cluster-key-idx 2, :fn-params-more nil, :fn-params-fixed [], :req-args-fixed ["CLIENT" "GETREDIR"], :fn-docstring "`CLIENT GETREDIR` Redis command.\n\nReturns the client ID to which the connection's tracking notifications are redirected.\n\nSince Redis 6.0.0. Complexity: O(1).\n\nReference: https://redis.io/commands/client-getredir/"}
"CLIENT HELP" {:fn-name "client-help", :cluster-key-idx 2, :fn-params-more nil, :fn-params-fixed [], :req-args-fixed ["CLIENT" "HELP"], :fn-docstring "`CLIENT HELP` Redis command.\n\nReturns helpful text about the different subcommands.\n\nSince Redis 5.0.0. Complexity: O(1).\n\nReference: https://redis.io/commands/client-help/"}
"CLIENT ID" {:fn-name "client-id", :cluster-key-idx 2, :fn-params-more nil, :fn-params-fixed [], :req-args-fixed ["CLIENT" "ID"], :fn-docstring "`CLIENT ID` Redis command.\n\nReturns the unique client ID of the connection.\n\nSince Redis 5.0.0. Complexity: O(1).\n\nReference: https://redis.io/commands/client-id/"}
"CLIENT INFO" {:fn-name "client-info", :cluster-key-idx 2, :fn-params-more nil, :fn-params-fixed [], :req-args-fixed ["CLIENT" "INFO"], :fn-docstring "`CLIENT INFO` Redis command.\n\nReturns information about the connection.\n\nSince Redis 6.2.0. Complexity: O(1).\n\nReference: https://redis.io/commands/client-info/"}
"CLIENT KILL" {:fn-name "client-kill", :cluster-key-idx 2, :fn-params-more [arg1 & args], :fn-params-fixed [arg1], :req-args-fixed ["CLIENT" "KILL" arg1], :fn-docstring "`CLIENT KILL` Redis command.\n\nTerminates open connections.\n\nSince Redis 2.4.0. Complexity: O(N) where N is the number of client connections.\n\nReference: https://redis.io/commands/client-kill/"}
"CLIENT LIST" {:fn-name "client-list", :cluster-key-idx 2, :fn-params-more [& args], :fn-params-fixed [], :req-args-fixed ["CLIENT" "LIST"], :fn-docstring "`CLIENT LIST` Redis command.\n\nLists open connections.\n\nSince Redis 2.4.0. Complexity: O(N) where N is the number of client connections.\n\nReference: https://redis.io/commands/client-list/"}
