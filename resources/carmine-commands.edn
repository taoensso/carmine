"LATENCY GRAPH" {:fn-name "latency-graph", :cluster-key-idx 2, :fn-params-more nil, :fn-params-fixed [event], :req-args-fixed ["LATENCY" "GRAPH" event], :fn-docstring "`LATENCY GRAPH` Redis command.\n\nReturns a latency graph for an event.\n\nSince Redis 2.8.13. Complexity: O(1).\n\nReference: https://redis.io/commands/latency-graph/"}
"LATENCY HELP" {:fn-name "latency-help", :cluster-key-idx 2, :fn-params-more nil, :fn-params-fixed [], :req-args-fixed ["LATENCY" "HELP"], :fn-docstring "`LATENCY HELP` Redis command.\n\nReturns helpful text about the different subcommands.\n\nSince Redis 2.8.13. Complexity: O(1).\n\nReference: https://redis.io/commands/latency-help/"}
"LATENCY HISTOGRAM" {:fn-name "latency-histogram", :cluster-key-idx 2, :fn-params-more [& args], :fn-params-fixed [], :req-args-fixed ["LATENCY" "HISTOGRAM"], :fn-docstring "`LATENCY HISTOGRAM` Redis command.\n\nReturns the cumulative distribution of latencies of a subset or all commands.\n\nSince Redis 7.0.0. Complexity: O(N) where N is the number of commands with latency information being retrieved.\n\nReference: https://redis.io/commands/latency-histogram/"}
